# Public HTTPS URL where this server is reachable (no trailing slash)
PUBLIC_URL=https://mcp.example.com

# Password you type when Claude asks to connect, and to open /admin
ADMIN_PASSWORD=change-me-long-random

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored tokens.
ENCRYPTION_KEY=

# Google OAuth client (Web application). Redirect URI: ${PUBLIC_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra app (multi-tenant + personal). Redirect URI: ${PUBLIC_URL}/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional
PORT=3000
DATA_DIR=./data
# Space-separated scope overrides
# GOOGLE_SCOPES=
# MS_SCOPES=
